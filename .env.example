# Copia este archivo como ".env" y cambia los valores.
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# XAMPP con root sin contraseña; deja vacío el valor entre ":" y "@" si aplica.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/portal_agua?charset=utf8mb4
# Si root tiene contraseña, inclúyela en la URL (codifica caracteres reservados).
# Poner en 1 cuando el sitio funcione con HTTPS:
# SESSION_COOKIE_SECURE=1

# reCAPTCHA v2: déjalo apagado en desarrollo local o enciéndelo con claves de prueba.
RECAPTCHA_ENABLED=0
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# En Railway: hostname sin protocolo ni ruta; separa dominios adicionales con comas.
RECAPTCHA_ALLOWED_HOSTNAMES=aguacomunidad.up.railway.app

# Notificaciones de reportes ciudadanos. Usa "resend" en Railway y "smtp" en local.
EMAIL_PROVIDER=smtp
EMAIL_REPORTS_TO=aguacomunidadsabana@gmail.com
# En Resend usa onboarding@resend.dev mientras no tengas un dominio verificado.
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=1
# SMTP_USERNAME=usuario
# SMTP_PASSWORD=contraseña
# SMTP_SENDER=portal@example.com

# Consulta administrativa del buzón de Gmail mediante IMAP sobre SSL.
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
